generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  TECHNICIAN
  ADMIN
}

enum RepairTicketStatus {
  DIAGNOSING
  AWAITING_PARTS
  IN_REPAIR
  READY_FOR_PICKUP
  COMPLETED
}

enum ProjectType {
  WEB_APP
  SAAS
  MOBILE_APP
  IT_INFRASTRUCTURE
}

enum ProjectQuoteStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(CLIENT)
  createdAt     DateTime       @default(now())
  repairTickets RepairTicket[]

  @@index([role])
}

model RepairTicket {
  id               String             @id @default(cuid())
  ticketNumber     String             @unique
  customerId       String
  customer         User               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  deviceType       String
  issueDescription String             @db.Text
  status           RepairTicketStatus @default(DIAGNOSING)
  estimatedCost    Decimal?           @db.Decimal(10, 2)
  createdAt        DateTime           @default(now())
  systemLogs       SystemLog[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model ProjectQuote {
  id           String             @id @default(cuid())
  clientName   String
  clientEmail  String
  projectType  ProjectType
  scopeDetails String             @db.Text
  budgetRange  String
  status       ProjectQuoteStatus @default(PENDING)

  @@index([clientEmail])
  @@index([status, projectType])
}

model SystemLog {
  id            String       @id @default(cuid())
  ticketId      String
  ticket        RepairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  updateMessage String       @db.Text
  timestamp     DateTime     @default(now())

  @@index([ticketId, timestamp])
}